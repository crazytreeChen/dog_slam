<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gps_fusion</name>
  <version>0.1.0</version>
  <description>GPS/RTK fusion pipeline — standalone testing package, independent of Nav2</description>

  <maintainer email="dev@dog-slam.com">Dog SLAM Team</maintainer>

  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>rclpy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>std_srvs</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <!-- pyproj for UTM conversion -->
  <exec_depend>python3-pyproj</exec_depend>
  <!-- tornado for WebSocket trajectory push (same as rosbridge_server) -->
  <exec_depend>python3-tornado</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
